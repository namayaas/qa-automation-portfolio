<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Tests that document real defects in the systems under test. These are EXPECTED TO FAIL
     until the defect is fixed; see TEST_PLAN.md section 9. Not run in CI. -->
<suite name="Known defects" verbose="1">
    <test name="Known defects">
        <groups><run><include name="knownDefect"/></run></groups>
        <packages><package name="com.nathalyamaya.qa.api"/></packages>
    </test>
</suite>
